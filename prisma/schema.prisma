generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Activity {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  date        DateTime
  createdAt   DateTime @default(now())
}

model BusinessTrip {
  id        Int      @id @default(autoincrement())
  title     String
  city      String
  startDate DateTime
  endDate   DateTime
  notes     String?
  createdAt DateTime @default(now())
}